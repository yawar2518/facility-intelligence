# ============================================================
# FACILITY INTELLIGENCE — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL + TimescaleDB) ---
POSTGRES_DB=facility_intelligence
POSTGRES_USER=fi_user
POSTGRES_PASSWORD=fi_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fi_user:fi_password@localhost:5432/facility_intelligence

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- MQTT ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# --- SendGrid ---
SENDGRID_API_KEY=your-sendgrid-api-key-here
DEFAULT_FROM_EMAIL=alerts@facility-intelligence.com

# --- Twilio (optional) ---
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# --- FastAPI ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001